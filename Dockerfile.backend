FROM python:3.11-slim AS runtime
LABEL org.opencontainers.image.title="gooil-dms-backend"
LABEL org.opencontainers.image.version="5.0.0-enterprise"

# System deps for reportlab (fonts, freetype), motor (openssl), curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl libfreetype6 libjpeg62-turbo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

# Install deps first for layer caching
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir emergentintegrations \
       --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/

# Copy application code
COPY backend/ .

# Non-root user
RUN groupadd -r app && useradd -r -g app appuser \
    && chown -R appuser:app /app
USER appuser

EXPOSE 8001

# Health probe — Kubernetes / Compose will hit /api/health
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fs http://localhost:8001/api/health || exit 1

# Prod-ish uvicorn — 2 workers is fine for the memory footprint; scale via container replicas.
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips=*"]
